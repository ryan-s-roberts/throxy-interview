{
  "name": "persona-ranker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/check-llm-env.mjs && next dev --turbopack",
    "build": "next build",
    "start": "node scripts/check-llm-env.mjs && next start",
    "check": "eslint src && prettier --check \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run -u",
    "e2e": "node scripts/e2e-rank.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/openai": "^3.0.41",
    "ai": "^6.0.116",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.3",
    "eslint-config-next": "16.1.6",
    "prettier": "^3.8.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}

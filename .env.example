# Add your AI provider API key. Uncomment the one you want to use.
# OPENROUTER_API_KEY=sk-or-...        # preferred — routes via openrouter.ai
# OPENROUTER_MODEL=openai/gpt-4o-mini # optional override
# OPENAI_API_KEY=sk-...
# OPENAPI_KEY=sk-...                  # alias for OPENAI_API_KEY
# ANTHROPIC_API_KEY=sk-ant-...

# Optional helper: copy keys from another env file into .env.local
#   bash scripts/setup-env.sh /path/to/your.env
